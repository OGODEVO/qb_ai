XAI_MODEL=grok-4

# QuickBooks API Credentials
# See: https://developer.intuit.com/app/developer/qbo/docs/develop/authentication-and-authorization/oauth-2.0
QB_REALM_ID=
QB_ACCESS_TOKEN=
